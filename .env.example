# Backend Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DATABASE_PATH=./data/talky.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# STUN/TURN Servers
STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server (uncomment if needed)
# TURN_SERVER=turn:openrelay.metered.ca:80
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject
# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Meeting Room Configuration
MEETING_ROOM_ID=default-meeting-room

# TURN Server Configuration (Optional - Free tier)
# Get free TURN credentials from https://www.metered.ca/
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Security (Generate random string for production)
SESSION_SECRET=your-secret-key-change-in-production

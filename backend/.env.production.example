# Production Environment Variables for Backend
# Copy this file to .env.production and fill in the values

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL (your Cloudflare Pages URL or custom domain)
FRONTEND_URL=https://your-app.pages.dev

# Database (local laptop path)
DATABASE_PATH=./data/talky.db

# Security - Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_random_string_here

# Push Notifications - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# TURN Server (Optional - for better NAT traversal)
# Free option: openrelay.metered.ca
# Or use paid service like Twilio
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
